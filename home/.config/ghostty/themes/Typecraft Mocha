# Catppuccin Mocha as actually used by typecraft-dev/dotfiles.
#
# Transcribed from his terminal colorschemes:
#   alacritty/.config/alacritty/catppuccin-mocha.toml
#   kitty/.config/kitty/current-theme.conf   (Catppuccin-Mocha, MIT, Pocco81)
#   starship/.config/starship.toml           [palettes.catppuccin_mocha]
#
# This is NOT the same as Ghostty's built-in "Catppuccin Mocha", which comes
# from iTerm2-Color-Schemes and differs in three visible ways:
#   1. Bright colors 9-15 are darkened there (#f37799, #89d88b, #ebd391,
#      #74a8fc, #f2aede, #6bd7ca). His use the SAME hex as the normal colors,
#      so bright text matches plain text.
#   2. palette 7 is #a6adc8 (overlay0) in the built-in, #bac2de (subtext1) here.
#   3. Selection is muted slate there (#585b70 on #cdd6f4), rosewater here.
#
# Alacritty was used as the structural reference since Ghostty shares its
# normal/bright layout. The two upstream files disagree on one value: kitty
# sets color15 to #a6adc8 while alacritty sets bright white to #bac2de. This
# follows alacritty, matching the terminal he actually runs.

palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#f5c2e7
palette = 6=#94e2d5
palette = 7=#bac2de
palette = 8=#585b70
palette = 9=#f38ba8
palette = 10=#a6e3a1
palette = 11=#f9e2af
palette = 12=#89b4fa
palette = 13=#f5c2e7
palette = 14=#94e2d5
palette = 15=#bac2de
palette = 16=#fab387
palette = 17=#f5e0dc

background = #1e1e2e
foreground = #cdd6f4
cursor-color = #f5e0dc
cursor-text = #1e1e2e
selection-background = #f5e0dc
selection-foreground = #1e1e2e
