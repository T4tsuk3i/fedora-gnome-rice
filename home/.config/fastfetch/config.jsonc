{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-direct",
        "source": "/home/tatsuya/Pictures/ghostty/bank/wh-1qorrv.png",
        "width": 40,
        "height": 12,
        "preserveAspectRatio": true,
        "padding": { "top": 0, "left": 0, "bottom": 0, "right": 2 }
    },
    "display": {
        "separator": " 󰅂 ",
        "color": {
            "separator": "37"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "   {1} 󰍹  {2}",
            "color": {
                "user": "36",
                "host": "34"
            }
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[34m╭─ 󰣇 System\u001b[0m"
        },
        {
            "type": "os",
            "key": "├─  ",
            "keyColor": "34"
        },
        {
            "type": "kernel",
            "key": "├─  ",
            "keyColor": "34"
        },
        {
            "type": "packages",
            "key": "├─  ",
            "keyColor": "34"
        },
        {
            "type": "uptime",
            "key": "╰─  ",
            "keyColor": "34"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[35m╭─ 󰢤 Hardware\u001b[0m"
        },
        {
            "type": "cpu",
            "key": "├─  ",
            "keyColor": "35"
        },
        {
            "type": "gpu",
            "key": "├─ 󰚗 ",
            "keyColor": "35"
        },
        {
            "type": "memory",
            "key": "├─  ",
            "keyColor": "35"
        },
        {
            "type": "disk",
            "key": "╰─ 󰋊 ",
            "keyColor": "35"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[36m╭─  Desktop\u001b[0m"
        },
        {
            "type": "wm",
            "key": "├─  ",
            "keyColor": "36"
        },
        {
            "type": "shell",
            "key": "├─  ",
            "keyColor": "36"
        },
        {
            "type": "terminal",
            "key": "├─  ",
            "keyColor": "36"
        },
        {
            "type": "media",
            "key": "╰─ 󰝚 ",
            "keyColor": "36"
        },
        "break",
        {
            "type": "colors",
            "symbol": "block",
            "paddingLeft": 2
        }
    ]
}
